Suggested logic for the ForwardSolver module (not implemented):

!**********************************************************************
  subroutine initSolver(iTx,m0,grid,e0)
!  Initializes FWD/ADJ solver for transmitter iTx.
!  If e0 is specified, assumes that we will run the forward solver.
!    Then, e0 stores the starting solution for the forward solver.
!    Also computes and stores the RHS b for the forward solver, using
!    the boundary conditions.
!  If e0 is not specified, assumes we are initializing for
!    sensitivities, in which case e0 = 0 and need not be computed.
!    Also, does not compute the RHS b,
!    as the FWD/ADJ solver will get it from comb.

   integer, intent(in)                         :: iTx
   type(modelParam_t),intent(in), target       :: m0
   type(grid_t), intent(in), target            :: grid
   type(solnVector_t), intent(inout), optional :: e0

   if (present(e0)) then
     sens = .false.
   endif

    ...

  end subroutine initSolver

!**********************************************************************
  subroutine fwdSolver(iTx,FWDorADJ,e,comb)
!  Generic forward solver; if comb is specified, it is used as forcing;
!  otherwise, assume that the RHS is already stored in b.
!  Use the input e for starting solution
!  (normally, e will be zero on input for sensitivities).

   integer, intent(in)                        :: iTx
   character (len=3), intent(in)                :: FWDorADJ
   type(solnVector_t), intent(inout)            :: e
   type(rhsVector_t), intent(inout), optional    :: comb

   if(.not. present(comb)) then
    ! use b as RHS
    adjoint = .false.
    sens = .false.
   else
    adjoint = (FWDorADJ .ne. FWD)
    sens = .true.
   endif

    ...

  end subroutine fwdSolver

  !**********************************************************************
  subroutine exitSolver()
   ! Cleans up after fwdSolver and deallocates all solver data. Call
   ! initSolver to update solver data; call this to exit completely.

        ...

  end subroutine exitSolver



